  <property name="windowTitle">
   <string notr="true">Form</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QCheckBox" name="checkStart">
     <property name="toolTip">
      <string>The silence or the background noise before the attack is removed.</string>
     </property>
     <property name="text">
      <string>Remove blank at start</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="labelEnd">
     <property name="text">
      <string>End of the sample:</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QRadioButton" name="radioEndUnchanged">
     <property name="text">
      <string>Unchanged</string>
     </property>
     <attribute name="buttonGroup">
      <string notr="true">groupEnd</string>
     </attribute>
    </widget>
   </item>
   <item>
    <widget class="QRadioButton" name="radioEndLoop">
     <property name="toolTip">
      <string>The data after the end of the loop is removed, unless an instrument doesn't play the loop continuously.</string>
     </property>
     <property name="text">
      <string>Trim after the end of loop</string>
     </property>
     <attribute name="buttonGroup">
      <string notr="true">groupEnd</string>
     </attribute>
    </widget>
   </item>
   <item>
    <widget class="QRadioButton" name="radioEndBlank">
     <property name="toolTip">
      <string>The blank at the end is replaced by a short fade-out prolonging the decay of the sound, so that the remaining noise doesn't stop abruptly.</string>
     </property>
     <property name="text">
      <string>Remove blank at end</string>
     </property>
     <attribute name="buttonGroup">
      <string notr="true">groupEnd</string>
     </attribute>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="labelThreshold">
     <property name="text">
      <string>Blank:</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QRadioButton" name="radioAutomatic">
     <property name="toolTip">
      <string>The blank is what is quieter than the background noise measured before or after the sound.</string>
     </property>
     <property name="text">
      <string>Detect the background noise</string>
     </property>
     <attribute name="buttonGroup">
      <string notr="true">groupThreshold</string>
     </attribute>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout">
     <item>
      <widget class="QRadioButton" name="radioLevel">
       <property name="toolTip">
        <string>The blank is what has a peak level below this value.</string>
